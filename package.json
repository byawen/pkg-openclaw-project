{
  "name": "pkg_openclaw",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "install:claw": "cd my-claw && npm install",
    "build:pkg": "node pkg-build/scripts/build-pkg-final.mjs --pkg-cache .pkg-cache --dist-dir dist-pkg --claw-dir my-claw",
    "build:pkg:macos-x64": "node pkg-build/scripts/build-pkg-final.mjs --target macos-x64 --pkg-cache .pkg-cache --dist-dir dist-pkg --claw-dir my-claw",
    "build:pkg:macos-arm64": "node pkg-build/scripts/build-pkg-final.mjs --target macos-arm64 --pkg-cache .pkg-cache --dist-dir dist-pkg --claw-dir my-claw",
    "build:pkg:win-x64": "node pkg-build/scripts/build-pkg-final.mjs --target win-x64 --pkg-cache .pkg-cache --dist-dir dist-pkg --claw-dir my-claw"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "files": [
    "main.js",
    "package.json"
  ],
  "devDependencies": {},
  "pkg": {
    "scripts": [
      "pkg-build/config/main-pkg-extract.cjs"
    ],
    "assets": [
      "package.json",
      ".pkg-cache/claw/claw-part-*.tar",
      ".pkg-cache/claw/version.json"
    ],
    "publicPackages": [
      "tar"
    ],
    "compress": "None",
    "fallbackToSource": true
  }
}