# Ignore unnecessary files during pkg packaging

# Development files
.git
.gitignore
.DS_Store
*.map
*.tsbuildinfo

# Build artifacts
dist/.buildstamp
dist/.runtime-postbuildstamp
dist/**/*.map

# Test files
test/
tests/
*.test.js
*.spec.js

# Documentation
docs/.generated
README.md
CHANGELOG.md

# Node modules to exclude
node_modules/.pnpm
node_modules/.bin

# Extension exclusions (keep only core)
node_modules/openclaw/dist/extensions/acpx
node_modules/openclaw/dist/extensions/node_modules
node_modules/openclaw/dist/extensions/*/node_modules
node_modules/openclaw/dist/extensions/bluebubbles
node_modules/openclaw/dist/extensions/brave
node_modules/openclaw/dist/extensions/codex
node_modules/openclaw/dist/extensions/diagnostics-otel
node_modules/openclaw/dist/extensions/diagnostics-prometheus
node_modules/openclaw/dist/extensions/diffs
node_modules/openclaw/dist/extensions/discord
node_modules/openclaw/dist/extensions/feishu
node_modules/openclaw/dist/extensions/google-meet
node_modules/openclaw/dist/extensions/googlechat
node_modules/openclaw/dist/extensions/line
node_modules/openclaw/dist/extensions/lobster
node_modules/openclaw/dist/extensions/memory-lancedb
node_modules/openclaw/dist/extensions/msteams
node_modules/openclaw/dist/extensions/nextcloud-talk
node_modules/openclaw/dist/extensions/nostr
node_modules/openclaw/dist/extensions/qqbot
node_modules/openclaw/dist/extensions/qa-channel
node_modules/openclaw/dist/extensions/qa-lab
node_modules/openclaw/dist/extensions/qa-matrix
node_modules/openclaw/dist/extensions/synology-chat
node_modules/openclaw/dist/extensions/tlon
node_modules/openclaw/dist/extensions/twitch
node_modules/openclaw/dist/extensions/voice-call
node_modules/openclaw/dist/extensions/whatsapp
node_modules/openclaw/dist/extensions/zalo
node_modules/openclaw/dist/extensions/zalouser

# Plugin SDK exclusions
node_modules/openclaw/dist/plugin-sdk/extensions/qa-channel
node_modules/openclaw/dist/plugin-sdk/extensions/qa-lab
node_modules/openclaw/dist/plugin-sdk/qa-channel.*
node_modules/openclaw/dist/plugin-sdk/qa-channel-protocol.*
node_modules/openclaw/dist/plugin-sdk/qa-lab.*
node_modules/openclaw/dist/plugin-sdk/qa-runtime.*
node_modules/openclaw/dist/plugin-sdk/src/plugin-sdk/qa-channel.d.ts
node_modules/openclaw/dist/plugin-sdk/src/plugin-sdk/qa-channel-protocol.d.ts
node_modules/openclaw/dist/plugin-sdk/src/plugin-sdk/qa-lab.d.ts
node_modules/openclaw/dist/plugin-sdk/src/plugin-sdk/qa-runtime.d.ts
node_modules/openclaw/dist/qa-runtime-*.js

# Cache and temp files
.cache
*.tmp
*.log
